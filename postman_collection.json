              "raw": "http://localhost:8000/api/v1/books?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                }
              ]
            },
            "description": "This request will fail with 401 Unauthorized (missing X-API-Key header)"
          },
          "response": []
        },
        {
          "name": "Invalid API Key (403 Error)",
          "request": {
