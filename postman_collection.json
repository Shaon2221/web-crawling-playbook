{
  "info": {
    "name": "Books Scraper API",
    "description": "Production-grade REST API for books.toscrape.com crawler with authentication, filtering, and change detection",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check (No Auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["health"]
            },
            "description": "Check if API is running (no authentication required)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Books Endpoints",
      "item": [
        {
          "name": "Get All Books (with filters & pagination)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "test-key-123",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/v1/books?category=Fiction&min_price=10&max_price=50&rating=3&sort_by=rating&page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "category",
                  "value": "Fiction",
                  "disabled": false
                },
                {
                  "key": "min_price",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "max_price",
                  "value": "50",
                  "disabled": false
                },
                {
                  "key": "rating",
                  "value": "3",
                  "disabled": false
                },
                {
                  "key": "sort_by",
                  "value": "rating",
                  "disabled": false,
                  "description": "Options: name, price, rating, reviews"
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                }
              ]
            },
            "description": "Retrieve books with optional filters for category, price range, rating, and sorting. Supports pagination."
          },
          "response": []
        },
        {
          "name": "Get All Books (No Filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "test-key-123",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/v1/books?page=1&limit=20",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "v1", "books"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "Get all books with default pagination (page 1, limit 20)"
          },
          "response": []
        },
        {
          "name": "Filter by Category",
