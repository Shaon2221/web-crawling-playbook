                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "10",
                  "disabled": false
                }
              ]
            },
            "description": "Get top-rated books"
          },
          "response": []
        },
        {
          "name": "Get Single Book by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "test-key-123",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/v1/books/507f1f77bcf86cd799439011",
              "protocol": "http",
