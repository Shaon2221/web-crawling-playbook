# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=books_scraper

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Crawler Configuration
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_FACTOR=2
CRAWLER_REQUEST_DELAY=1

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_TIMEZONE=UTC

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=3600
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Alert Configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# API Keys (comma-separated for initial setup; store in secure vault in production)
VALID_API_KEYS=test-key-123,test-key-456
