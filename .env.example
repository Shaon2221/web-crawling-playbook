# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=books_crawler
MONGODB_COLLECTION=books

# Crawler Configuration
CRAWLER_BASE_URL=https://books.toscrape.com
CRAWLER_MAX_CONCURRENT_REQUESTS=10
CRAWLER_REQUEST_DELAY=0.5
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT=30
CRAWLER_USER_AGENT=BooksBot/1.0 (+https://github.com/yourusername/books-crawler)

# Checkpoint/Resume Configuration
CHECKPOINT_ENABLED=true
CHECKPOINT_FILE=data/checkpoints/crawler_state.json
CHECKPOINT_INTERVAL=10

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_TIMEZONE=UTC

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
API_WORKERS=4

# API Security
API_KEY_HEADER=X-API-Key
API_KEYS=your-secret-api-key-1,your-secret-api-key-2

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/crawler.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Application Environment
ENVIRONMENT=production
DEBUG=false
